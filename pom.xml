    <groupId>net.aschemann.jqassistant.plugins</groupId>
    <artifactId>jqa-groovy-plugin</artifactId>
    <!-- tag::version[] -->
    <version>0.2.0-SNAPSHOT</version>
    <!-- end::version[] -->

    <name>jQAssistant Groovy Plugin</name>
    <description>Groovy analyzer for jQAssistant</description>
    <url>https://aschemann.net/</url>
    <inceptionYear>2021</inceptionYear>

    <organization>
        <name>Gerd Aschemann (Freelancer)</name>
        <url>https://aschemann.net/</url>
    </organization>

    <licenses>
        <license>
            <name>GNU General Public License, v3</name>
            <url>https://www.gnu.org/licenses/gpl-3.0.html</url>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/ascheman/jqa-groovy-plugin.git</url>
    </scm>

    <developers>
        <developer>
            <id>ascheman</id>
            <name>Gerd Aschemann</name>
            <email>gerd@aschemann.net</email>
            <roles>
                <role>developer</role>
            </roles>
        </developer>
    </developers>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>


        <project.build.outputTimestamp>2023-01-01T00:00:00Z</project.build.outputTimestamp>

        <assertj-core.version>3.27.7</assertj-core.version>
        <jqa.version>2.9.1</jqa.version>
        <junit-jupiter.version>5.14.3</junit-jupiter.version>
        <maven-dependency-plugin.version>3.10.0</maven-dependency-plugin.version>
        <maven-failsafe-plugin.version>3.5.5</maven-failsafe-plugin.version>
        <maven-invoker-plugin.version>3.9.1</maven-invoker-plugin.version>
        <maven-surefire-plugin.version>3.5.5</maven-surefire-plugin.version>
        <maven-versions-plugin.version>2.21.0</maven-versions-plugin.version>
        <groovy.version>5.0.4</groovy.version>
        <slf4j.version>2.0.17</slf4j.version>
        <slf4j-simple.version>2.0.17</slf4j-simple.version>
        <jreleaser-maven-plugin.version>1.26.0</jreleaser-maven-plugin.version>
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
        <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
        <maven-source-plugin.version>3.4.0</maven-source-plugin.version>

        <!--
          Signing subkey of gerd@aschemann.net. The trailing "!" pins gpg to exactly
          this RSA-4096 subkey: the primary key of that uid is a 1024 bit DSA key from
          2005 and must never end up on a published signature. Override on the command
          line with -Dgpg.keyname=... when releasing from a different keyring.
        -->
        <gpg.keyname>D6D79905C2FDD3E4FA6C13A9F3182FD01BA43E49!</gpg.keyname>

    </properties>




    <build>
        <!--
          jqassistant-plugin.xml carries version="${project.version}", which jQAssistant
          logs as the plugin version - unfiltered it shows the literal placeholder.
          Filtering is scoped to that one file on purpose: rule files and FreeMarker
          templates use ${...} for their own purposes and must pass through untouched.
        -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>META-INF/jqassistant-plugin.xml</include>
                </includes>
                <filtering>true</filtering>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>META-INF/jqassistant-plugin.xml</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>${maven-dependency-plugin.version}</version>
                <executions>
                    <execution>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>analyze-only</goal>
                        </goals>
                        <configuration>
                            <failOnWarning>true</failOnWarning>
                            <ignoreNonCompile>false</ignoreNonCompile>
                            <verbose>true</verbose>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${maven-failsafe-plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <version>${maven-versions-plugin.version}</version>
                <configuration>
                    <generateBackupPoms>false</generateBackupPoms>
                    <rulesUri>file://${project.basedir}/src/build/version-rules.xml</rulesUri>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-invoker-plugin</artifactId>
                <version>${maven-invoker-plugin.version}</version>
                <configuration>
                    <debug>true</debug>
                    <cloneProjectsTo>${project.build.directory}/it</cloneProjectsTo>
                    <pomIncludes>
                        <pomInclude>*/pom.xml</pomInclude>
                    </pomIncludes>
                    <postBuildHookScript>verify</postBuildHookScript>
                    <localRepositoryPath>${project.build.directory}/local-repo</localRepositoryPath>
                    <settingsFile>src/it/settings.xml</settingsFile>
                    <goals>
                        <goal>clean</goal>
                        <goal>verify</goal>
                    </goals>
                    <properties>
                        <jqa.version>${jqa.version}</jqa.version>
                    </properties>
                </configuration>
                <executions>
                    <execution>
                        <id>integration-test</id>
                        <goals>
                            <goal>install</goal>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.buschmais.jqassistant</groupId>
                <artifactId>bom</artifactId>
                <version>${jqa.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>com.buschmais.jqassistant.core</groupId>
            <artifactId>report</artifactId>
        </dependency>
        <dependency>
            <groupId>com.buschmais.jqassistant.core</groupId>
            <artifactId>rule</artifactId>
        </dependency>
        <dependency>
            <groupId>com.buschmais.jqassistant.core</groupId>
            <artifactId>store</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.groovy</groupId>
            <artifactId>groovy</artifactId>
            <version>${groovy.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <!-- Test dependencies -->
        <dependency>
            <groupId>com.buschmais.jqassistant.plugin</groupId>
            <artifactId>common</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit-jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj-core.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j-simple.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
      SNAPSHOTs go to the Central Portal snapshot repository. It is readable
      anonymously, so anyone can consume a SNAPSHOT by adding

          https://central.sonatype.com/repository/maven-snapshots/

      as a repository - no credentials, no token handed out. GitHub Packages
      answers 401 even for public packages, which made every consumer need
      their own token; that is why it is no longer used here.

      Deploying needs the Central Portal user token in a <server> with this id,
      and SNAPSHOT publishing enabled for the namespace in the Portal (without
      that the upload is rejected with 403, not 401).
    -->
    <distributionManagement>
        <snapshotRepository>
            <id>central-snapshots</id>
            <name>Central Portal Snapshots</name>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
        </snapshotRepository>
    </distributionManagement>

    <profiles>
        <profile>
            <!--
              CI keeps publishing SNAPSHOTs to GitHub Packages, unchanged.
              Activated by GITHUB_ACTIONS, which GitHub Actions sets and a local
              shell does not - unlike GITHUB_TOKEN, which is also exported by
              the local direnv setup and would therefore hijack local deploys.
              A profile's distributionManagement overrides the project-level one
              for the same element, so this wins inside Actions only.

              Interim state: SNAPSHOTs then live in two places depending on who
              deploys. Drop this profile (and the workflow's deploy step) once
              CI publishing is sorted out.
            -->
            <id>github-ci</id>
            <activation>
                <property>
                    <name>env.GITHUB_ACTIONS</name>
                </property>
            </activation>
            <distributionManagement>
                <snapshotRepository>
                    <id>github</id>
                    <name>GitHub Packages</name>
                    <url>https://maven.pkg.github.com/ascheman/${project.artifactId}</url>
                </snapshotRepository>
            </distributionManagement>
        </profile>
        <profile>
            <!--
              Release from a local working copy, so that signing uses the local GnuPG
              agent and the private key never leaves this machine:

                  ./mvnw -Prelease clean deploy
                  ./mvnw -Prelease jreleaser:full-release

              The first command builds, signs and stages everything into
              ${staging.repository.directory}; the second uploads that staging
              repository to Maven Central and creates the GitHub release.

              Credentials come from the environment, never from the repository:
              JRELEASER_GITHUB_TOKEN plus JRELEASER_MAVENCENTRAL_USERNAME and
              JRELEASER_MAVENCENTRAL_PASSWORD (the Central Portal user token, not
              the account password). JReleaser itself is configured in jreleaser.yml.
            -->
            <id>release</id>
            <properties>
                <staging.repository.directory>${project.build.directory}/staging-deploy</staging.repository.directory>
            </properties>
            <distributionManagement>
                <!--
                  Deploy to a local directory rather than to a remote repository.
                  JReleaser picks the artifacts up from here, which keeps the upload
                  a separate, repeatable step: a failed upload does not require a rebuild.

                  Both elements point at the staging directory on purpose. A
                  profile's distributionManagement is *merged* with the one
                  outside it, element by element, rather than replacing it. With
                  only <repository> declared here, a `-Prelease deploy` run on a
                  version that still carried -SNAPSHOT would fall through to the
                  snapshot repository and leave the staging directory empty.
                -->
                <repository>
                    <id>staging</id>
                    <url>file://${staging.repository.directory}</url>
                </repository>
                <snapshotRepository>
                    <id>staging</id>
                    <url>file://${staging.repository.directory}</url>
                </snapshotRepository>
            </distributionManagement>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${maven-source-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${maven-javadoc-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <keyname>${gpg.keyname}</keyname>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.jreleaser</groupId>
                        <artifactId>jreleaser-maven-plugin</artifactId>
                        <version>${jreleaser-maven-plugin.version}</version>
                        <configuration>
                            <!--
                              Required. The Maven plugin does NOT pick up
                              jreleaser.yml by itself: without configFile it
                              builds its model from this POM instead
                              (AbstractJReleaserMojo: `null == configFile ?
                              convertModel() : readModel(logger)`), silently
                              ignoring the file. The symptom is not an error
                              but "[maven] Deploying is not enabled. Skipping",
                              because the whole deploy section is then absent
                              from the model. Check the log for
                              "Configuring with .../jreleaser.yml".
                            -->
                            <configFile>${project.basedir}/jreleaser.yml</configFile>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

    </profiles>
</project>
